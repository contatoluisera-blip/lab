rules_version = '2';

// Firebase Storage — publicar em Console > Storage > Regras.
// O servidor (Admin SDK) não passa por estas regras: Foto de Estúdio e resultados da geração
// são gravados por ele. Os resultados são abertos pelo link com token de download.
service firebase.storage {
  match /b/{bucket}/o {

    // Arquivos de entrada da geração (frames, referências e vídeo para vídeo):
    // cada pessoa só envia e lê na própria pasta, até 10 MB, imagem JPG/PNG ou vídeo MP4/MOV.
    match /gen-inputs/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)|video/(mp4|quicktime)');
      allow update, delete: if false;
    }

    // Arquivos da Montagem: takes (vídeos), miniaturas e artes do vídeo (letterings, logos, marca d'água, vinheta).
    // Cada pessoa só envia, lê e apaga na própria pasta; vídeo MP4/MOV/WEBM até 200 MB, imagem PNG/JPG/WEBP até 10 MB.
    match /montagem-uploads/{userId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && ((request.resource.contentType.matches('video/(mp4|quicktime|webm)') && request.resource.size <= 200 * 1024 * 1024)
          || (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10 * 1024 * 1024));
      allow update: if false;
    }

    // Resultados: só leitura do dono (o servidor grava).
    match /gen-outputs/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Vídeos exportados na Montagem: só leitura do dono (o servidor grava).
    match /renders/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Todo o resto: fechado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
