# Creator Lab — variáveis de ambiente (copie para .env.local no Mac; na Netlify, cadastre em Environment variables)
# Públicas (vão para o navegador): Firebase cliente
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=https://mobilelab.com.br

# Firebase Admin (segredo) — Console Firebase > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=            # segredo
STRIPE_WEBHOOK_SECRET=        # segredo
STRIPE_PRODUCT_START=         # prod_...
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_ELITE=
STRIPE_PRODUCT_START_ANNUAL=  # opcional
STRIPE_PRODUCT_PRO_ANNUAL=
STRIPE_PRODUCT_ELITE_ANNUAL=

# Provedores de IA (segredos)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
KIE_AI_API_KEY=
RESEND_API_KEY=

# Opcionais: trocar modelos sem mexer no código
# OPENAI_MODEL_MAIN=gpt-4o
# OPENAI_MODEL_FAST=gpt-4o-mini
# ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6
# KIE_MODEL_IMAGE=nano-banana-2
# E-mails e admin
# EMAIL_FROM="Creator Lab <contato@mobilelab.com.br>"
# SUPERADMIN_EMAIL=
