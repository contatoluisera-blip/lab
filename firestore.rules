rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário: o próprio usuário lê tudo, mas só altera campos de preferência.
    // Plano, créditos, teste grátis e dados da Stripe são gravados apenas pelo servidor (Admin SDK).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.plan == 'free'
        && request.resource.data.credits == 0
        && !request.resource.data.keys().hasAny(['trialUsed', 'creditsResetAt', 'currentPeriodEnd', 'manualGrant',
                     'stripeCustomerId', 'stripeSubscriptionId', 'stripeSubscriptionStatus']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plan', 'credits', 'trialUsed', 'creditsResetAt', 'currentPeriodEnd', 'manualGrant',
                     'stripeCustomerId', 'stripeSubscriptionId', 'stripeSubscriptionStatus']);
      allow delete: if false;

      // Favoritos do Hub de Referências: só o dono lê e escreve.
      match /hub_favorites/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Extrato de créditos: o usuário pode ver, nunca escrever.
      match /credit_ledger/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Diagnósticos em andamento: só leitura do dono (o servidor escreve).
    match /diagnosis_jobs/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Diagnósticos: usuário autenticado pode ler/escrever os seus próprios
    match /diagnoses/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Cálculos de orçamento
    match /calculations/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Ideias geradas
    match /ideas/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Hub de Referências: catálogo e vídeos aprovados são leitura para logados;
    // fontes, fila, execuções e configurações só o servidor (Admin SDK) acessa.
    match /hub_catalog/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /hub_videos/{videoId} {
      allow read: if request.auth != null && resource.data.status == 'approved';
      allow write: if false;
    }

    // Prompts gerados (Gerador de Prompts)
    match /prompts/{docId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Propostas comerciais
    match /proposals/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Estúd.IA gerações (o servidor cria e atualiza; o usuário só lê e apaga as suas)
    match /estudia/{docId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // Clientes gerenciados
    match /clients/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
